  "description": "Orchestra is an AI-driven DevOps assistant with a modular plugin architecture.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "orchestra": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "PLUGINS.md",
    "GUIDE.md",
    "action.yml",
    "Dockerfile"
  ],
  "scripts": {
    "test": "jest",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveMind/Orchestra.git"
  },
  "keywords": [
